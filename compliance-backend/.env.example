# ─── Application ───
APP_NAME=ComplianceAI
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://compliance_user:compliance_pass@postgres:5432/compliance_db
DATABASE_URL_SYNC=postgresql://compliance_user:compliance_pass@postgres:5432/compliance_db

# ─── Redis ───
REDIS_URL=redis://redis:6379/0

# ─── Authentication ───
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Anthropic (Claude) ───
ANTHROPIC_API_KEY=COLE_SUA_CHAVE_AQUI
ANTHROPIC_MODEL=claude-sonnet-5
# Teto da resposta. Abaixo de 16384 um contrato longo com muitos alertas
# volta cortado no meio, e o erro aparece como JSON inválido.
ANTHROPIC_MAX_TOKENS=16384
ANTHROPIC_TIMEOUT=300

# ─── OpenAI (Embeddings) ───
OPENAI_API_KEY=COLE_SUA_CHAVE_AQUI
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ─── Storage ───
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=10

# ─── Celery ───
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── CORS ───
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
