# ─── Application ───
APP_NAME=ComplianceAI
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://compliance_user:compliance_pass@postgres:5432/compliance_db
DATABASE_URL_SYNC=postgresql://compliance_user:compliance_pass@postgres:5432/compliance_db

# ─── Authentication ───
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Anthropic (Claude) ───
ANTHROPIC_API_KEY=COLE_SUA_CHAVE_AQUI
ANTHROPIC_MODEL=claude-sonnet-5
# Teto da resposta. Abaixo de 16384 um contrato longo com muitos alertas
# volta cortado no meio, e o erro aparece como JSON inválido.
ANTHROPIC_MAX_TOKENS=16384
ANTHROPIC_TIMEOUT=300

# ─── OpenAI (Embeddings) ───
OPENAI_API_KEY=COLE_SUA_CHAVE_AQUI
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ─── Storage ───
# local: arquivo em UPLOAD_DIR (em container, use um volume persistente)
# s3:    bucket compatível com S3 (Supabase Storage, Cloudflare R2, AWS)
STORAGE_BACKEND=local
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=10

# Só com STORAGE_BACKEND=s3
# Supabase: S3_ENDPOINT_URL=https://<projeto>.supabase.co/storage/v1/s3, S3_REGION=<região do projeto>
# R2:       S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto
# AWS:      deixe S3_ENDPOINT_URL vazio e use a região do bucket
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=uploads/

# ─── Análise em background ───
# Análises simultâneas dentro da api
ANALYSIS_MAX_CONCURRENT=2
# Minutos sem sinal de vida até a análise ser dada como órfã e virar erro
ORPHAN_TIMEOUT_MINUTES=12
# Teto da análise: passado isto desde a primeira tentativa, o batimento para
ANALYSIS_MAX_DURATION_MINUTES=60

# ─── CORS ───
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
